{
    "name": "@hodfords/nestjs-seeder",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "A tool for seeding databases in NestJS apps",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "build": "tsc",
        "start": "node --experimental-strip-types src/index.ts",
        "wz-command": "wz-command",
        "cspell": "cspell --no-must-find-files lib/**/*.{ts,js}",
        "prepare": "is-ci || husky",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"lib/**/*.ts\"",
        "lint": "eslint \"lib/**/*.ts\" \"src/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-seeder.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-seeder/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-seeder#readme",
    "devDependencies": {
        "@faker-js/faker": "10.6.0",
        "@hodfords/nestjs-command": "12.1.1",
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@nestjs/typeorm": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/node": "26.4.0",
        "commander": "15.0.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "lodash": "4.18.1",
        "pg": "8.23.0",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "glob": "^13.0.6"
    },
    "peerDependencies": {
        "@hodfords/nestjs-command": ">=12.0.0",
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/testing": ">=12.0.0",
        "typeorm": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "typeorm": {
            "optional": true
        }
    }
}
